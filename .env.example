# CodeGuard AI Configuration Example

PROJECT_NAME="CodeGuard AI"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL or SQLite)
# For local development with SQLite:
DATABASE_URL="sqlite+aiosqlite:///./codeguard.db"
SYNC_DATABASE_URL="sqlite:///./codeguard.db"

# For PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://codeguard_user:codeguard_password@localhost:5432/codeguard_db"
# SYNC_DATABASE_URL="postgresql://codeguard_user:codeguard_password@localhost:5432/codeguard_db"

# Storage & Repository Limits
STORAGE_DIR="./storage"
MAX_REPO_SIZE_MB=50
MAX_FILE_SIZE_KB=500
MAX_FILES_TO_ANALYZE=100

# AI / LLM Provider ("heuristic", "openai", "gemini", "anthropic", "ollama")
LLM_PROVIDER="heuristic"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Ollama Local LLM
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# RAG Knowledge Base
KNOWLEDGE_BASE_DIR="./data/knowledge"
RAG_TOP_K=3

# Technical Debt Weights (Sum to 1.0)
WEIGHT_SECURITY=0.35
WEIGHT_QUALITY=0.25
WEIGHT_BUGS=0.20
WEIGHT_COMPLEXITY=0.15
WEIGHT_DUPLICATION=0.05
